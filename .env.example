# Copy this file to .env and point it at one complete, immutable schema-2 bundle.
AIC_ARTIFACT_DIR=E:/AIC2026/artifacts/clip-b32-btc-v1

# cpu, cuda, or cuda:N. Defaults to CUDA when available, otherwise CPU.
AIC_DEVICE=cuda

# Enable only when artifact_manifest.json declares text_only_lora and the
# bundle includes the matching lora_weights.pt checkpoint.
AIC_USE_LORA=false

# This package never opens keyframe JPEGs. Configure AIC_KEYFRAME_ROOT only in
# the task-orchestration repository that performs OCR/VLM/TRAKE logic.
