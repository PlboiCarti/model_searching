# Copy this file to .env and point it at one complete artifact bundle.
# All index files below must have been created with the matching CLIP model.
AIC_ARTIFACT_DIR=D:/AIC/artifacts/clip-b32-raw-v1
AIC_CLIP_MODEL_NAME=ViT-B/32
AIC_USE_LORA=false
# This repository accepts only a text-only LoRA checkpoint. Its metadata must
# declare clip_model=ViT-B/32 and adapter_scope=text_only; BTC image vectors stay raw.
# AIC_LORA_WEIGHTS_PATH=D:/AIC/artifacts/clip-b32-lora-v1/lora_weights.pt

# Optional explicit paths when the teammate artifact does not use standard names.
# AIC_FAISS_INDEX_PATH=D:/AIC/artifacts/clip-b32-raw-v1/video.index
# AIC_FAISS_METADATA_PATH=D:/AIC/artifacts/clip-b32-raw-v1/index_metadata.json
# AIC_SCENE_FAISS_INDEX_PATH=D:/AIC/artifacts/clip-b32-raw-v1/scene.index
# AIC_SCENE_METADATA_PATH=D:/AIC/artifacts/clip-b32-raw-v1/scene_metadata.json

# cuda, cpu, or the teammate's supported device configuration.
AIC_DEVICE=cuda
